{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Map Vite+ toolchain versions from npm manifests; consumers supply release-age and merge policy.",
  "customDatasources": {
    "vite-plus-component": {
      "transformTemplates": [
        "{'latest': $.\"dist-tags\".latest, 'releases': $each(versions, function($m, $v) { {'parent': $v, 'core': $substringAfter($m.dependencies.vite, 'npm:@voidzero-dev/vite-plus-core@'), 'vitest': $m.dependencies.vitest, 'releaseTimestamp': $lookup($$.time, $v)} })}",
        "{'latest': latest, 'releases': releases[$exists($match(parent, /^\\d+\\.\\d+\\.\\d+$/)) and $exists($match(core, /^\\d+\\.\\d+\\.\\d+$/)) and $exists($match(vitest, /^\\d+\\.\\d+\\.\\d+$/)) and $exists(releaseTimestamp)]}",
        "($assert($count(releases[parent = $$.latest]) = 1, 'Vite+ latest must have exact stable component versions and a timestamp'); $)",
        "($field := '{{{packageName}}}' = 'vite-plus' ? 'parent' : '{{{packageName}}}' = '@voidzero-dev/vite-plus-core' ? 'core' : 'vitest'; {'tags': {'latest': $lookup(releases[parent = $$.latest], $field)}, 'sourceUrl': $field = 'vitest' ? 'https://github.com/vitest-dev/vitest' : 'https://github.com/voidzero-dev/vite-plus', 'releases': [releases.{'version': $lookup($, $field), 'releaseTimestamp': releaseTimestamp}]})"
      ]
    }
  },
  "packageRules": [
    {
      "description": "Keep the runner, core, coverage and Playwright provider on the versions bundled by Vite+.",
      "matchDatasources": [
        "npm",
        "custom.vite-plus-component"
      ],
      "matchPackageNames": [
        "vite-plus",
        "@voidzero-dev/vite-plus-core",
        "vitest",
        "@vitest/coverage-v8",
        "@vitest/coverage-istanbul",
        "@vitest/browser-playwright"
      ],
      "groupName": "vite-plus toolchain",
      "separateMajorMinor": false,
      "internalChecksFilter": "none",
      "overrideDatasource": "custom.vite-plus-component",
      "registryUrls": [
        "https://registry.npmjs.org/vite-plus"
      ],
      "versioning": "npm",
      "followTag": "latest",
      "groupSlug": "vite-plus-toolchain"
    }
  ]
}
